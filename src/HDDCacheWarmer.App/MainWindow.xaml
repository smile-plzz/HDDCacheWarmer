<Window x:Class="HDDCacheWarmer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDD Cache Warmer" Height="480" Width="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Folder picker row -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseButton_Click"/>
            <Button DockPanel.Dock="Right" Content="Settings" Click="SettingsButton_Click"/>
            <TextBox x:Name="FolderTextBox" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Start Warming" Click="StartButton_Click" x:Name="StartButton"/>
            <Button Content="Pause" Click="PauseButton_Click" x:Name="PauseButton" IsEnabled="False"/>
            <Button Content="Resume" Click="ResumeButton_Click" x:Name="ResumeButton" IsEnabled="False"/>
            <Button Content="Cancel" Click="CancelButton_Click" x:Name="CancelButton" IsEnabled="False"/>
            <Button Content="Hide" Click="HideButton_Click" x:Name="HideButton"/>
        </StackPanel>

        <!-- Progress bar + percent -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="MainProgressBar" Grid.Column="0" Height="22" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="PercentText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="0%"/>
        </Grid>

        <TextBlock x:Name="PhaseText" Grid.Row="3" FontWeight="Bold" Margin="0,0,0,8" Text="Idle"/>

        <!-- Stats grid -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Current file:" FontWeight="SemiBold"/>
                <TextBlock x:Name="CurrentFileText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Current directory:" FontWeight="SemiBold"/>
                <TextBlock x:Name="CurrentDirText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Files processed / total:" FontWeight="SemiBold"/>
                <TextBlock x:Name="FilesText" Margin="0,0,0,8"/>
                <TextBlock Text="Bytes read / total:" FontWeight="SemiBold"/>
                <TextBlock x:Name="BytesText" Margin="0,0,0,8"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Current speed:" FontWeight="SemiBold"/>
                <TextBlock x:Name="CurrentSpeedText" Margin="0,0,0,8"/>
                <TextBlock Text="Average speed:" FontWeight="SemiBold"/>
                <TextBlock x:Name="AvgSpeedText" Margin="0,0,0,8"/>
                <TextBlock Text="Elapsed / ETA:" FontWeight="SemiBold"/>
                <TextBlock x:Name="TimeText" Margin="0,0,0,8"/>
                <TextBlock Text="Skipped / Errors:" FontWeight="SemiBold"/>
                <TextBlock x:Name="SkippedErrorsText" Margin="0,0,0,8"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="SummaryText" Grid.Row="5" TextWrapping="Wrap" FontStyle="Italic"/>
    </Grid>
</Window>
