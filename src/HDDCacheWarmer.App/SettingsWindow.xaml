<Window x:Class="HDDCacheWarmer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="520" Width="460" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Buffer size (MB)" FontWeight="SemiBold"/>
        <TextBox x:Name="BufferSizeBox" Margin="0,4,0,12"/>

        <TextBlock Text="Read order" FontWeight="SemiBold"/>
        <ComboBox x:Name="ReadOrderBox" Margin="0,4,0,12"/>

        <TextBlock Text="Process priority" FontWeight="SemiBold"/>
        <ComboBox x:Name="PriorityBox" Margin="0,4,0,12"/>

        <TextBlock Text="Include extensions (comma-separated, e.g. .mp4,.mkv — blank = all files)" FontWeight="SemiBold"/>
        <TextBox x:Name="ExtensionsBox" Margin="0,4,0,12"/>

        <TextBlock Text="Excluded folders (comma-separated names or full paths)" FontWeight="SemiBold"/>
        <TextBox x:Name="ExcludedFoldersBox" Margin="0,4,0,12"/>

        <TextBlock Text="Max file size in MB (0 = no limit)" FontWeight="SemiBold"/>
        <TextBox x:Name="MaxFileSizeBox" Margin="0,4,0,12"/>

        <CheckBox x:Name="IdleOnlyBox" Content="Only run when the system is idle" Margin="0,0,0,8"/>
        <CheckBox x:Name="TrayStartupBox" Content="Run in system tray at startup" Margin="0,0,0,8"/>
        <CheckBox x:Name="ContextMenuBox" Content="Add &quot;Warm Windows Cache&quot; to the Explorer right-click menu" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="CancelButton_Click"/>
            <Button Content="Save" Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
